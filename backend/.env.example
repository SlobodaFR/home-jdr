# Copiez ce fichier en .env (jamais commité) et complétez les valeurs.

# Requis - service d'authentification central (auth.sloboda.fr)
AUTH_SERVICE_URL=https://auth.sloboda.fr
AUTH_CLIENT_ID=jdr
AUTH_CLIENT_SECRET=change-me

# Requis - secret partagé avec auth-service pour le webhook de révocation
# (POST /api/auth/disconnect?secret=..., cf. auth.controller.ts)
AUTH_WEBHOOK_SECRET=change-me

# Optionnel - base URL du frontend, utilisée pour le redirect_uri OAuth2 et CORS
FRONTEND_URL=http://localhost:5173

# Optionnel - chemin du fichier SQLite
DATABASE_PATH=

# Optionnel - emails admin (rôle "admin" attribué à la première connexion),
# séparés par des virgules. Les autres utilisateurs reçoivent le rôle "adult"
# par défaut - voir user-role-policy.ts
ADMIN_EMAILS=

# Optionnel
NODE_ENV=development
PORT=3000

# Optionnel - réplication Litestream de la DB SQLite vers MinIO (S3-compatible)
# Si MINIO_BUCKET est défini, le conteneur restaure la DB au démarrage et la
# réplique en continu.
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_REPLICA_PATH=home-jdr
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=

# Utilisé à partir de la tâche 04-llm-orchestration.md
# LLM_PROVIDER: "claude" (défaut) ou "openai" - sélectionne l'adapter LlmGameMasterPort actif.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Optionnel - tous les combien de tours le résumé glissant est régénéré (défaut 20).
ROLLING_SUMMARY_INTERVAL=

# Utilisé à partir de la tâche 05-world-map.md
IMAGE_PROVIDER=

# Utilisé à partir de la tâche 06-notifications-push.md
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Utilisé à partir de la tâche 08-admin-quotas-cost-guardrails.md
DAILY_LLM_QUOTA=
