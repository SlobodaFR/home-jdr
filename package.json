{
  "name": "home-jdr",
  "version": "1.0.0",
  "private": true,
  "description": "JdR pilot\u00e9 par LLM, multi-joueurs, jouable en famille",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build": "npm run build:frontend && npm run build:backend",
    "test:backend": "npm run test --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "typecheck": "npm run typecheck --workspace=backend && npx tsc -b --noEmit frontend",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix"
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "@swc/core": true,
    "@nestjs/core": false,
    "fsevents": false
  },
  "devDependencies": {
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007"
  }
}
